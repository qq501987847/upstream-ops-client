{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "火灵 API 客户端",
  "version": "0.1.0",
  "identifier": "com.upstreamops.workbuddy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "火灵 API 客户端",
        "width": 960,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
